# Copie para .env.local e preencha. Nunca commitar .env.local.
# Supabase local: `pnpm db:start` mostra a URL e as chaves.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor. Nunca expor no cliente.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# Chaves de teste do Turnstile para desenvolvimento: 1x00000000000000000000AA e 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Na Vercel, deixe sem: o site usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
IP_HASH_SALT=
CRON_SECRET=
EMAIL_FROM="Voto Lá Fora <nao-responda@votolafora.com.br>"
# Só no lançamento: libera os buscadores. Sem ela, o site inteiro fica fora do Google.
# PERMITIR_INDEXACAO=1
# Opcional, só no desenvolvimento: sem RESEND_API_KEY, os e-mails vão para o Mailpit.
# MAILPIT_URL=http://127.0.0.1:54324

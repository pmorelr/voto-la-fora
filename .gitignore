# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# o exemplo de variáveis vai para o git
!.env.example

# worker do MapLibre, copiado de node_modules a cada dev/build
/public/maplibre

# PDF gerado por scripts/pdf-revisao.mjs
/revisao-juridica-*.pdf

# PDF gerado por scripts/pdf-oficial.mjs
/juridico/*.pdf
/voto-la-fora-documentos-legais-*.pdf
